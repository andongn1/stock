APP_ENV=dev
APP_SECRET=
APP_DEBUG=true

# Database (SQLite by default)
DATABASE_URL=sqlite://%kernel.project_dir%/var/data.db
# For MySQL:
# DATABASE_URL=mysql://db_user:db_password@127.0.0.1:3306/stock_app?serverVersion=8.0

# Mailer
MAILER_DSN=null://null

# Security
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_HOSTS=localhost,127.0.0.1

# Session
SESSION_HANDLER_ID=null

# Assets
ASSET_MAPPER_COMPOLDER_DIRS=assets
