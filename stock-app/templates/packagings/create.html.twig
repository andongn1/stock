{% extends 'base.html.twig' %}

{% block title %}Créer un Conditionnement{% endblock %}

{% block header_content %}
    <div class="flex justify-between items-center">
        
            Créer un Conditionnement
        
    </div>
{% endblock %}

{% block body %}
    <div class="py-6">
        <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
            <div class="bg-white dark:bg-slate-800 overflow-hidden shadow-sm sm:rounded-lg">
                <div class="p-6">
                    <form action="{{ path('packagings.store') }}" method="POST">
                        {{ form_row(form.name, {'label': 'Nom', 'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        
                        <div class="mt-6">
                            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg shadow transition-colors">
                                Créer le Conditionnement
                            </button>
                            <a href="{{ path('packagings.index') }}" class="ml-2 px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white rounded-lg transition-colors">
                                Annuler
                            </a>
                        </div>
                        
                        <input type="hidden" name="_token" value="{{ csrf_token('create_packaging') }}">
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
