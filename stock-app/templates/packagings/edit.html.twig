{% extends 'layouts/app.html.twig' %}

{% block page_title %}Editer Conditionnement{% endblock %}

{% block content %}
<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Editer Conditionnement</h1>
        <a href="{{ path('packagings.index') }}" class="px-4 py-2 bg-gray-500 text-white rounded-md hover:bg-gray-600 transition-colors">
            Retour
        </a>
    </div>
    
    {{ form_start(form) }}
    <div class="space-y-6">
        <div>
            <label for="packaging_name" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Nom *</label>
            {{ form_widget(form.name, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
            <div class="text-red-500 text-sm mt-1">
                {{ form_errors(form.name) }}
            </div>
        </div>
        
        <div class="flex justify-end space-x-4">
            <a 
                href="{{ path('packagings.index') }}"
                class="px-6 py-2 bg-gray-500 text-white rounded-md hover:bg-gray-600 transition-colors"
            >
                Annuler
            </a>
            <button 
                type="submit" 
                class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors"
            >
                <svg class="w-5 h-5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Mettre a jour
            </button>
        </div>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
