{% extends 'base.html.twig' %}

{% block title %}Détails Utilisateur{% endblock %}

{% block header_content %}
    <div class="flex justify-between items-center">
        
            Détails de l'utilisateur
        
    </div>
{% endblock %}

{% block body %}
    <div class="py-6">
        <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
            <div class="bg-white dark:bg-slate-800 overflow-hidden shadow-sm sm:rounded-lg">
                <div class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">
                                Informations personnelles
                            </h3>
                            
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">
                                        Nom complet
                                    </label>
                                    <div class="text-gray-800 dark:text-white">
                                        {{ user.name }}
                                    </div>
                                </div>
                                
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">
                                        Email
                                    </label>
                                    <div class="text-gray-800 dark:text-white">
                                        {{ user.email }}
                                    </div>
                                </div>
                                
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">
                                        Rôle
                                    </label>
                                    <span class="px-2 py-1 rounded-full text-xs font-medium {% if user.role.value == 'admin' %}bg-red-100 text-red-800{% else %}bg-green-100 text-green-800{% endif %}">
                                        {{ user.role.value|capitalize }}
                                    </span>
                                </div>
                            </div>
                        </div>
                        
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">
                                Métadonnées
                            </h3>
                            
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">
                                        ID
                                    </label>
                                    <div class="text-gray-800 dark:text-white">
                                        {{ user.id }}
                                    </div>
                                </div>
                                
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">
                                        Date de création
                                    </label>
                                    <div class="text-gray-800 dark:text-white">
                                        {{ user.createdAt|date('d/m/Y H:i:s') }}
                                    </div>
                                </div>
                                
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">
                                        Dernière mise à jour
                                    </label>
                                    <div class="text-gray-800 dark:text-white">
                                        {{ user.updatedAt|date('d/m/Y H:i:s') }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-6 flex justify-end space-x-3">
                <a href="{{ path('users.edit', {'id': user.id}) }}" 
                   class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors flex items-center space-x-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                    <span>Editer</span>
                </a>
                
                <a href="{{ path('users.index') }}" 
                   class="px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white rounded-lg transition-colors">
                    Retour à la liste
                </a>
            </div>
        </div>
    </div>
{% endblock %}
