{% extends 'base.html.twig' %}

{% block title %}Créer Utilisateur{% endblock %}

{% block header_content %}
    <div class="flex justify-between items-center">
        <h2 class="font-semibold text-xl text-gray-800 leading-tight">
            Créer un nouvel utilisateur
        </h2>
    </div>
{% endblock %}

{% block body %}
    <div class="py-12">
        <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
            <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg">
                <div class="p-6">
                    <p class="text-gray-500 mb-6">
                        Seuls les administrateurs peuvent créer des utilisateurs.
                    </p>
                    
                    <form action="{{ path('users.store') }}" method="POST" class="space-y-6">
                        {{ form_row(form.name, {'label': 'Nom complet', 'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        
                        {{ form_row(form.email, {'label': 'Email', 'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        
                        {{ form_row(form.plainPassword, {'label': 'Mot de passe', 'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        
                        {{ form_row(form.role, {'label': 'Rôle', 'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        
                        <div class="mt-6">
                            <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg shadow transition-colors">
                                Créer l'utilisateur
                            </button>
                            <a href="{{ path('users.index') }}" class="ml-2 px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-lg transition-colors">
                                Annuler
                            </a>
                        </div>
                        
                        <input type="hidden" name="_token" value="{{ csrf_token('create_user') }}">
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
