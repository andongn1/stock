{% extends 'layouts/app.html.twig' %}

{% block page_title %}Article - {{ article.name }}{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
        <div class="flex justify-between items-start mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-800 dark:text-white">{{ article.name }}</h1>
                <p class="text-gray-500 dark:text-slate-400 mt-1">Marque: {{ article.brand }}</p>
            </div>
            <div class="flex space-x-2">
                <a href="{{ path('articles.edit', {'id': article.id}) }}" class="px-3 py-1.5 bg-green-600 text-white rounded-md hover:bg-green-700 text-sm transition-colors">
                    Editer
                </a>
                <a href="{{ path('articles.index') }}" class="px-3 py-1.5 bg-gray-500 text-white rounded-md hover:bg-gray-600 text-sm transition-colors">
                    Retour
                </a>
            </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Famille</label>
                    <p class="text-gray-900 dark:text-white">{{ article.family ? article.family.name : '-' }}</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Sous-Famille</label>
                    <p class="text-gray-900 dark:text-white">{{ article.subFamily ? article.subFamily.name : '-' }}</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Unite</label>
                    <p class="text-gray-900 dark:text-white">{{ article.unit ? article.unit.name : '-' }}</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Conditionnement</label>
                    <p class="text-gray-900 dark:text-white">{{ article.packaging ? article.packaging.name : '-' }}</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Quantite par conditionnement</label>
                    <p class="text-gray-900 dark:text-white">{{ article.packagingUnitQuantity }}</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">TVA</label>
                    <p class="text-gray-900 dark:text-white">{{ article.vat ? article.vat.label ~ ' (' ~ article.vat.rate ~ '%)' : '-' }}</p>
                </div>
            </div>
            
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Prix d'achat actuel</label>
                    {% if currentPrice %}
                    <p class="text-green-600 dark:text-green-400 font-semibold">
                        {{ currentPrice.price }} {{ currentPrice.currency }} ({{ currentPrice.supplier.name }})
                    </p>
                    <p class="text-sm text-gray-500 dark:text-slate-400">
                        Valable depuis le {{ currentPrice.validFrom|date('d/m/Y') }}
                    </p>
                    {% else %}
                    <p class="text-gray-500 dark:text-slate-400">Aucun prix enregistre</p>
                    {% endif %}
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Prix de vente</label>
                    {% if article.sellingPrices|length > 0 %}
                        {% for sp in article.sellingPrices %}
                        <p class="text-blue-600 dark:text-blue-400 font-semibold">
                            {{ sp.priceTtc }} {{ sp.currency }} ({{ sp.saleType|capitalize }})
                        </p>
                        {% endfor %}
                    {% else %}
                    <p class="text-gray-500 dark:text-slate-400">Aucun prix de vente Defini</p>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <div class="mt-6 border-t border-gray-200 dark:border-slate-700 pt-6">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Autres fournisseurs</h2>
            {% if otherSupplierPrices|length > 0 %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                    <thead class="bg-gray-50 dark:bg-slate-700">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Fournisseur</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Prix</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Date</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white dark:bg-slate-800 divide-y divide-gray-200 dark:divide-gray-700">
                        {% for supplierId, price in otherSupplierPrices %}
                        <tr>
                            <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">
                                {{ price.supplier.name }}
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-slate-400">
                                {{ price.price }} {{ price.currency }}
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-slate-400">
                                {{ price.validFrom|date('d/m/Y') }}
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap text-right">
                                <form action="{{ path('articles.set_current_supplier', {'id': article.id}) }}" method="POST">
                                    <input type="hidden" name="price_history_id" value="{{ price.id }}">
                                    <button type="submit" class="px-3 py-1 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700 transition-colors">
                                        Activer
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <p class="text-gray-500 dark:text-slate-400">Aucun autre fournisseur</p>
            {% endif %}
        </div>
    </div>
    
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white">Ajouter un prix</h2>
        </div>
        
        <form action="{{ path('articles.add_price', {'id': article.id}) }}" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label for="supplier_id" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Fournisseur *</label>
                    <select name="supplier_id" id="supplier_id" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white" required>
                        <option value="">Selectionnez un fournisseur</option>
                        {% for supplier in suppliers %}
                        <option value="{{ supplier.id }}">{{ supplier.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="price" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Prix *</label>
                    <input type="number" step="0.01" name="price" id="price" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white" required>
                </div>
                <div>
                    <label for="currency" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Devise</label>
                    <select name="currency" id="currency" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white">
                        <option value="EUR" selected>EUR</option>
                        <option value="USD">USD</option>
                        <option value="CHF">CHF</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Type de prix</label>
                <select name="price_type" class="w-full md:w-auto px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white">
                    <option value="per_unit">par unite</option>
                    <option value="per_packaging">par conditionnement</option>
                </select>
            </div>
            <div class="flex justify-end">
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                    Ajouter le prix
                </button>
            </div>
        </form>
    </div>
    
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white">Mettre a jour le prix de vente</h2>
        </div>
        
        {% if article.sellingPrices|length > 0 %}
            {% for sp in article.sellingPrices %}
            <form action="{{ path('articles.update_selling_price', {'id': article.id}) }}" method="POST" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label for="price_ttc" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Prix TTC *</label>
                        <input type="number" step="0.01" name="price_ttc" id="price_ttc" value="{{ sp.priceTtc }}" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white" required>
                    </div>
                    <div>
                        <label for="sale_type" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Type de vente</label>
                        <select name="sale_type" id="sale_type" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white">
                            <option value="per_unit" {% if sp.saleType == 'per_unit' %}selected{% endif %}>par unite</option>
                            <option value="per_packaging" {% if sp.saleType == 'per_packaging' %}selected{% endif %}>par conditionnement</option>
                            <option value="both" {% if sp.saleType == 'both' %}selected{% endif %}>les deux</option>
                        </select>
                    </div>
                    <div>
                        <label for="quantity" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Quantite</label>
                        <input type="number" step="0.01" name="quantity" id="quantity" value="{{ sp.quantity }}" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white">
                    </div>
                </div>
                <div>
                    <label for="currency" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Devise</label>
                    <select name="currency" id="currency" class="w-full md:w-auto px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white">
                        <option value="EUR" {% if sp.currency == 'EUR' %}selected{% endif %}>EUR</option>
                        <option value="USD" {% if sp.currency == 'USD' %}selected{% endif %}>USD</option>
                        <option value="CHF" {% if sp.currency == 'CHF' %}selected{% endif %}>CHF</option>
                    </select>
                </div>
                <div class="flex justify-end">
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                        Mettre a jour
                    </button>
                </div>
            </form>
            {% endfor %}
        {% else %}
        <form action="{{ path('articles.update_selling_price', {'id': article.id}) }}" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label for="price_ttc" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Prix TTC *</label>
                    <input type="number" step="0.01" name="price_ttc" id="price_ttc" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white" required>
                </div>
                <div>
                    <label for="sale_type" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Type de vente</label>
                    <select name="sale_type" id="sale_type" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white">
                        <option value="per_unit">par unite</option>
                        <option value="per_packaging">par conditionnement</option>
                        <option value="both">les deux</option>
                    </select>
                </div>
                <div>
                    <label for="quantity" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Quantite</label>
                    <input type="number" step="0.01" name="quantity" id="quantity" value="1" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white">
                </div>
            </div>
            <div>
                <label for="currency" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Devise</label>
                <select name="currency" id="currency" class="w-full md:w-auto px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white">
                    <option value="EUR" selected>EUR</option>
                    <option value="USD">USD</option>
                    <option value="CHF">CHF</option>
                </select>
            </div>
            <div class="flex justify-end">
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                    Ajouter le prix de vente
                </button>
            </div>
        </form>
        {% endif %}
    </div>
    
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white">
                <a href="{{ path('articles.price_histories', {'id': article.id}) }}" class="text-blue-600 dark:text-blue-400 hover:underline">
                    Historique des prix
                </a>
            </h2>
        </div>
    </div>
</div>
{% endblock %}
