{% extends 'layouts/app.html.twig' %}

{% block page_title %}Historique des prix - {{ article.name }}{% endblock %}

{% block content %}
<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Historique des prix - {{ article.name }}</h1>
        <a href="{{ path('articles.show', {'id': article.id}) }}" class="px-4 py-2 bg-gray-500 text-white rounded-md hover:bg-gray-600 transition-colors">
            Retour
        </a>
    </div>
    
    {% if priceHistories|length > 0 %}
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-slate-700">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Fournisseur</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Prix</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Type</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Valable du</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Valable au</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-slate-300 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white dark:bg-slate-800 divide-y divide-gray-200 dark:divide-gray-700">
                {% for priceHistory in priceHistories %}
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">
                        {{ priceHistory.supplier.name }}
                    </td>
                    <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-slate-400">
                        {{ priceHistory.price }} {{ priceHistory.currency }}
                    </td>
                    <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-slate-400">
                        {{ priceHistory.priceType|capitalize }}
                    </td>
                    <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-slate-400">
                        {{ priceHistory.validFrom|date('d/m/Y') }}
                    </td>
                    <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-slate-400">
                        {{ priceHistory.validTo ? priceHistory.validTo|date('d/m/Y') : 'Présent' }}
                    </td>
                    <td class="px-4 py-4 whitespace-nowrap text-right">
                        <form action="{{ path('articles.set_current_supplier', {'id': article.id}) }}" method="POST">
                            <input type="hidden" name="price_history_id" value="{{ priceHistory.id }}">
                            <button type="submit" class="px-3 py-1 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700 transition-colors">
                                Reactiver
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="text-center py-8 text-gray-500 dark:text-slate-400">
        Aucun historique de prix trouve.
    </div>
    {% endif %}
</div>
{% endblock %}
