{% extends 'base.html.twig' %}

{% block title %}Créer un Article{% endblock %}

{% block header_content %}
    <div class="flex justify-between items-center">
        <h2 class="font-semibold text-xl text-gray-800 leading-tight">
            Créer un Article
        </h2>
    </div>
{% endblock %}

{% block body %}
    <div class="py-12">
        <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
            <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg">
                <div class="p-6">
                    <form action="{{ path('articles.store') }}" method="POST" enctype="multipart/form-data">
                        {{ form_row(form.name, {'label': 'Nom', 'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_row(form.brand, {'label': 'Marque', 'required': false, 'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_row(form.family, {'label': 'Famille', 'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_row(form.subFamily, {'label': 'Sous-Famille', 'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_row(form.unit, {'label': 'Unité', 'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_row(form.packaging, {'label': 'Conditionnement', 'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_row(form.packagingUnitQuantity, {'label': 'Quantité unitaire', 'required': false, 'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_row(form.vat, {'label': 'TVA', 'attr': {'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        
                        <div class="mt-6">
                            <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg shadow transition-colors">
                                Créer l'Article
                            </button>
                            <a href="{{ path('articles.index') }}" class="ml-2 px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-lg transition-colors">
                                Annuler
                            </a>
                        </div>
                        
                        <input type="hidden" name="_token" value="{{ csrf_token('create_article') }}">
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
