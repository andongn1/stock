{% extends 'layouts/app.html.twig' %}

{% block page_title %}Ajouter un Article{% endblock %}

{% block content %}
<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Ajouter un Article</h1>
        <a href="{{ path('articles.index') }}" class="px-4 py-2 bg-gray-500 text-white rounded-md hover:bg-gray-600 transition-colors">
            Retour
        </a>
    </div>
    
    {{ form_start(form) }}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            <label for="article_name" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Nom *</label>
            {{ form_widget(form.name, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
            <div class="text-red-500 text-sm mt-1">{{ form_errors(form.name) }}</div>
        </div>
        
        <div>
            <label for="article_brand" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Marque</label>
            {{ form_widget(form.brand, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
            <div class="text-red-500 text-sm mt-1">{{ form_errors(form.brand) }}</div>
        </div>
        
        <div>
            <label for="article_family" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Famille</label>
            {{ form_widget(form.family, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
            <div class="text-red-500 text-sm mt-1">{{ form_errors(form.family) }}</div>
        </div>
        
        <div>
            <label for="article_subFamily" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Sous-Famille</label>
            {{ form_widget(form.subFamily, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
            <div class="text-red-500 text-sm mt-1">{{ form_errors(form.subFamily) }}</div>
        </div>
        
        <div>
            <label for="article_unit" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Unite *</label>
            {{ form_widget(form.unit, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
            <div class="text-red-500 text-sm mt-1">{{ form_errors(form.unit) }}</div>
        </div>
        
        <div>
            <label for="article_packaging" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Conditionnement *</label>
            {{ form_widget(form.packaging, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
            <div class="text-red-500 text-sm mt-1">{{ form_errors(form.packaging) }}</div>
        </div>
        
        <div>
            <label for="article_packagingUnitQuantity" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Quantite par conditionnement *</label>
            {{ form_widget(form.packagingUnitQuantity, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
            <div class="text-red-500 text-sm mt-1">{{ form_errors(form.packagingUnitQuantity) }}</div>
        </div>
        
        <div>
            <label for="article_vat" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">TVA *</label>
            {{ form_widget(form.vat, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
            <div class="text-red-500 text-sm mt-1">{{ form_errors(form.vat) }}</div>
        </div>
    </div>
    
    <div class="mt-6 flex justify-end">
        <button 
            type="submit" 
            class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors"
        >
            <svg class="w-5 h-5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Enregistrer
        </button>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
