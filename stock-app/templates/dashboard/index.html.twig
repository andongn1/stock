                <div>
                    <p class="text-3xl font-bold">0</p>
                    <p class="text-sm">Utilisateurs</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="mt-8">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Actions rapides</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <a href="{{ path('articles.index') }}" class="bg-white dark:bg-slate-700 p-4 rounded-lg shadow hover:shadow-md transition-shadow">
                <p class="text-gray-800 dark:text-white">Gerer les articles</p>
            </a>
            <a href="{{ path('families.index') }}" class="bg-white dark:bg-slate-700 p-4 rounded-lg shadow hover:shadow-md transition-shadow">
                <p class="text-gray-800 dark:text-white">Gerer les familles</p>
            </a>
            <a href="{{ path('inventories.index') }}" class="bg-white dark:bg-slate-700 p-4 rounded-lg shadow hover:shadow-md transition-shadow">
                <p class="text-gray-800 dark:text-white">Faire l'inventaire</p>
            </a>
            <a href="{{ path('entries.index') }}" class="bg-white dark:bg-slate-700 p-4 rounded-lg shadow hover:shadow-md transition-shadow">
                <p class="text-gray-800 dark:text-white">Ajouter des entrees</p>
            </a>
        </div>
    </div>
</div>
{% endblock %}
