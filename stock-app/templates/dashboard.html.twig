{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block header_content %}
    <h1 class="text-lg font-semibold text-gray-800 dark:text-white">Tableau de bord</h1>
{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6">
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-center space-x-4">
                <div class="p-3 bg-blue-100 dark:bg-blue-900/30 rounded-full">
                    <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                    </svg>
                </div>
                <div>
                    <p class="text-3xl font-bold text-gray-800 dark:text-white">{{ articleCount }}</p>
                    <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Articles</p>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-center space-x-4">
                <div class="p-3 bg-green-100 dark:bg-green-900/30 rounded-full">
                    <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4z"></path>
                    </svg>
                </div>
                <div>
                    <p class="text-3xl font-bold text-gray-800 dark:text-white">{{ familyCount }}</p>
                    <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Familles</p>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-center space-x-4">
                <div class="p-3 bg-orange-100 dark:bg-orange-900/30 rounded-full">
                    <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                </div>
                <div>
                    <p class="text-3xl font-bold text-gray-800 dark:text-white">{{ supplierCount }}</p>
                    <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Fournisseurs</p>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-center space-x-4">
                <div class="p-3 bg-purple-100 dark:bg-purple-900/30 rounded-full">
                    <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
                    </svg>
                </div>
                <div>
                    <p class="text-3xl font-bold text-gray-800 dark:text-white">{{ unitCount }}</p>
                    <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Unités</p>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-center space-x-4">
                <div class="p-3 bg-red-100 dark:bg-red-900/30 rounded-full">
                    <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                    </svg>
                </div>
                <div>
                    <p class="text-3xl font-bold text-gray-800 dark:text-white">{{ entryCount }}</p>
                    <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Entrées</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Articles per Family -->
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Articles par famille (Top 5)</h3>
            <div class="space-y-3">
                {% for item in articlesPerFamily %}
                    <div class="flex justify-between items-center">
                        <div class="flex items-center space-x-2">
                            <span class="w-3 h-3 bg-blue-500 rounded-full"></span>
                            <span class="text-sm text-gray-700 dark:text-slate-300">{{ item.name }}</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <div class="w-20 bg-gray-200 dark:bg-slate-700 rounded-full h-2">
                                <div class="bg-blue-500 h-2 rounded-full" style="width: {{ maxCount > 0 ? (item.count / maxCount) * 100 : 0 }}%"></div>
                            </div>
                            <span class="text-sm text-gray-600 dark:text-slate-400">{{ item.count }}</span>
                        </div>
                    </div>
                {% else %}
                    <p class="text-sm text-gray-500 dark:text-slate-400">Aucune donnée</p>
                {% endfor %}
            </div>
        </div>

        <!-- Articles with/without prices -->
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Articles avec/sans prix</h3>
            <div class="space-y-3">
                <div class="flex justify-between items-center">
                    <div class="flex items-center space-x-2">
                        <span class="w-3 h-3 bg-green-500 rounded-full"></span>
                        <span class="text-sm text-gray-700 dark:text-slate-300">Avec prix</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <div class="w-20 bg-gray-200 dark:bg-slate-700 rounded-full h-2">
                            <div class="bg-green-500 h-2 rounded-full" style="width: {{ (articlesWithPrices + articlesWithoutPrices) > 0 ? (articlesWithPrices / (articlesWithPrices + articlesWithoutPrices)) * 100 : 0 }}%"></div>
                        </div>
                        <span class="text-sm text-gray-600 dark:text-slate-400">{{ articlesWithPrices }}</span>
                    </div>
                </div>
                <div class="flex justify-between items-center">
                    <div class="flex items-center space-x-2">
                        <span class="w-3 h-3 bg-gray-500 rounded-full"></span>
                        <span class="text-sm text-gray-700 dark:text-slate-300">Sans prix</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <div class="w-20 bg-gray-200 dark:bg-slate-700 rounded-full h-2">
                            <div class="bg-gray-500 h-2 rounded-full" style="width: {{ (articlesWithPrices + articlesWithoutPrices) > 0 ? (articlesWithoutPrices / (articlesWithPrices + articlesWithoutPrices)) * 100 : 0 }}%"></div>
                        </div>
                        <span class="text-sm text-gray-600 dark:text-slate-400">{{ articlesWithoutPrices }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Recent Entries -->
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Dernières entrées</h3>
            <div class="space-y-3">
                {% for entry in recentEntries %}
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-700 dark:text-slate-300">{{ entry.article.name ?? 'N/A' }}</span>
                        <span class="text-gray-500 dark:text-slate-400">{{ entry.quantity }} {{ entry.article.unit.name ?? '' }}</span>
                    </div>
                {% else %}
                    <p class="text-sm text-gray-500 dark:text-slate-400">Aucune entrée récente</p>
                {% endfor %}
            </div>
        </div>

        <!-- Recent Inventories -->
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Derniers inventaires</h3>
            <div class="space-y-3">
                {% for inventory in recentInventories %}
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-700 dark:text-slate-300">{{ inventory.article.name ?? 'N/A' }}</span>
                        <span class="text-gray-500 dark:text-slate-400">{{ inventory.quantity }}</span>
                    </div>
                {% else %}
                    <p class="text-sm text-gray-500 dark:text-slate-400">Aucun inventaire récent</p>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
