{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block header_content %}
    <h2 class="font-semibold text-xl text-gray-800 leading-tight">
        Dashboard
    </h2>
{% endblock %}

{% block body %}
    <div class="py-12">
        <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
            <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg">
                <div class="p-6 text-gray-900">
                    <p class="mb-4">Bienvenue sur votre tableau de bord de gestion de stock !</p>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <div class="bg-blue-50 p-6 rounded-lg">
                            <h3 class="text-lg font-semibold text-blue-800 mb-2">Actions rapides</h3>
                            <div class="space-y-2">
                                <a href="{{ path('articles.index') }}" class="block text-blue-600 hover:text-blue-800">
                                    - Gérer les articles
                                </a>
                                <a href="{{ path('families.index') }}" class="block text-blue-600 hover:text-blue-800">
                                    - Gérer les familles
                                </a>
                                <a href="{{ path('inventories.index') }}" class="block text-blue-600 hover:text-blue-800">
                                    - Faire un inventaire
                                </a>
                            </div>
                        </div>
                        
                        <div class="bg-green-50 p-6 rounded-lg">
                            <h3 class="text-lg font-semibold text-green-800 mb-2">Statistiques</h3>
                            <p>Statistiques à venir...</p>
                        </div>
                        
                        <div class="bg-yellow-50 p-6 rounded-lg">
                            <h3 class="text-lg font-semibold text-yellow-800 mb-2">Récents</h3>
                            <p>Activités récentes à venir...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
