{% extends 'base.html.twig' %}

{% block title %}Entrées de Stock{% endblock %}

{% block header_content %}
    <div class="flex justify-between items-center">
        <h2 class="font-semibold text-xl text-gray-800 leading-tight">
            Entrées de stock
        </h2>
    </div>
{% endblock %}

{% block body %}
    <div class="py-12">
        <div class="max-w-7xl mx-auto sm:px-6 lg:px-8 space-y-6">
            <!-- Search Section -->
            <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg">
                <div class="p-6">
                    <form method="GET" action="{{ path('entries.search') }}" class="space-y-4">
                        <div class="flex gap-3">
                            <input 
                                type="text" 
                                name="search" 
                                value="{{ search }}"
                                placeholder="Rechercher un article (nom)..."
                                class="flex-1 p-3 border border-gray-300 rounded-lg bg-white text-gray-900"
                                required
                            >
                            <button 
                                type="submit"
                                class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition-colors font-medium flex items-center space-x-2"
                            >
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                                <span>Rechercher Article</span>
                            </button>
                        </div>
                    </form>
                    
                    <!-- Search Results -->
                    {% if search %}
                    <div class="mt-6">
                        <h3 class="text-lg font-medium text-gray-700 mb-3">
                            Résultats de recherche ({{ articles|length }})
                        </h3>
                        <div class="space-y-2 max-h-48 overflow-y-auto">
                            {% for article in articles %}
                            <div class="p-3 bg-gray-50 rounded-lg border border-gray-200 flex justify-between items-center">
                                <div>
                                    <span class="font-medium text-gray-800">{{ article.name }}</span>
                                    {% if article.brand %}
                                    <span class="text-sm text-gray-500 ml-2">- {{ article.brand }}</span>
                                    {% endif %}
                                    <div class="text-sm text-gray-600">
                                        {{ article.packaging?article.packaging.name:'N/A' }} 
                                        {% if article.packagingUnitQuantity %}
                                        ({{ article.packagingUnitQuantity }} {{ article.unit?article.unit.name:'' }})
                                        {% endif %}
                                    </div>
                                </div>
                                <a 
                                    href="{{ path('entries.create', {'id': article.id}) }}"
                                    class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm rounded-lg transition-colors font-medium"
                                >
                                    Ajouter une entrée
                                </a>
                            </div>
                            {% else %}
                            <div class="p-4 text-gray-500 text-center">
                                Aucun article trouvé.
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
            
            <!-- Entries Table -->
            {% if todayEntries|length > 0 %}
            <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg">
                <div class="p-6">
                    <h3 class="text-lg font-medium text-gray-700 mb-4">
                        Entrées de stock du {{ 'now'|date('d/m/Y') }}
                    </h3>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="border-b border-gray-200">
                                    <th class="text-left py-3 px-4 text-sm font-medium text-gray-500">Article</th>
                                    <th class="text-left py-3 px-4 text-sm font-medium text-gray-500">Conditionnement</th>
                                    <th class="text-left py-3 px-4 text-sm font-medium text-gray-500">Qté/Conditionnement</th>
                                    <th class="text-left py-3 px-4 text-sm font-medium text-gray-500">Qté Reçue</th>
                                    <th class="text-left py-3 px-4 text-sm font-medium text-gray-500">Valeur Totale (Quantité)</th>
                                    <th class="text-left py-3 px-4 text-sm font-medium text-gray-500">Valeur Totale (€)</th>
                                    <th class="text-right py-3 px-4 text-sm font-medium text-gray-500">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for entry in todayEntries %}
                                <tr class="border-b border-gray-100">
                                    <td class="py-3 px-4 text-gray-800">
                                        {{ entry.article.name }}
                                    </td>
                                    <td class="py-3 px-4 text-gray-600">
                                        {{ entry.article.packaging?entry.article.packaging.name:'N/A' }}
                                    </td>
                                    <td class="py-3 px-4 text-gray-600">
                                        {{ entry.article.packagingUnitQuantity }} {{ entry.article.unit?entry.article.unit.name:'' }}
                                    </td>
                                    <td class="py-3 px-4 text-gray-800">
                                        {{ entry.quantity }}
                                    </td>
                                    <td class="py-3 px-4 text-gray-800">
                                        {{ "%.2f"|format(entry.totalQuantity) }} {{ entry.article.unit?entry.article.unit.name:'' }}
                                    </td>
                                    <td class="py-3 px-4 text-gray-800">
                                        {{ "%.2f"|format(entry.monetaryValue) }} €
                                    </td>
                                    <td class="py-3 px-4 text-right">
                                        <form method="POST" action="{{ path('entries.destroy', {'id': entry.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entry.id) }}">
                                            <input type="hidden" name="_method" value="DELETE">
                                            <button 
                                                type="submit"
                                                onclick="return confirm('Etes-vous sûr de vouloir supprimer cette entrée ?')"
                                                class="text-red-600 hover:text-red-700 text-sm font-medium"
                                            >
                                                <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                </svg>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-4 text-sm text-gray-500">
                        Total: {{ todayEntries|length }} entrées enregistrées aujourd'hui
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
