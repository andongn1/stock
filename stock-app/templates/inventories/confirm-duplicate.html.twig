{% extends 'base.html.twig' %}

{% block title %}Confirmer Inventaire{% endblock %}

{% block header_content %}
    <div class="flex justify-between items-center">
        <h2 class="font-semibold text-xl text-gray-800 leading-tight">
            Confirmer l'inventaire
        </h2>
    </div>
{% endblock %}

{% block body %}
    <div class="py-12">
        <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
            <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg">
                <div class="p-6">
                    <div class="bg-yellow-50 px-4 pt-5 pb-4 rounded-lg mb-6">
                        <div class="flex items-start">
                            <div class="flex-shrink-0">
                                <svg class="h-6 w-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                </svg>
                            </div>
                            <div class="ml-3">
                                <h3 class="text-lg leading-6 font-medium text-yellow-800">
                                    Article déjà inventorié aujourd'hui
                                </h3>
                                <div class="mt-2">
                                    <p class="text-sm text-yellow-700">
                                        L'article <strong>{{ article.name }}</strong> a déjà été inventorié aujourd'hui 
                                        avec une quantité de <strong>{{ existing.quantity }}</strong> {{ article.packaging?article.packaging.name:'' }}.
                                    </p>
                                    <p class="text-sm text-yellow-700 mt-2">
                                        Vous avez saisi une nouvelle quantité de <strong>{{ pending.quantity }}</strong> {{ article.packaging?article.packaging.name:'' }}.
                                    </p>
                                    <p class="text-sm text-yellow-700 mt-2">
                                        Que souhaitez-vous faire ?
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="space-y-3">
                        <form method="POST" action="{{ path('inventories.process-duplicate', {'id': article.id}) }}" class="bg-gray-50 p-4 rounded-lg">
                            <input type="hidden" name="action" value="add">
                            <input type="hidden" name="family_id" value="{{ pending.family_id ?? '' }}">
                            <div class="flex items-center justify-between">
                                <div>
                                    <h4 class="font-medium text-gray-800">Ajouter au stock existant</h4>
                                    <p class="text-sm text-gray-600">
                                        Le nouveau stock sera ajouté à l'ancien. 
                                        {% if article.packaging?article.packaging.name %}
                                        Ex: {{ existing.quantity }} + {{ pending.quantity }} = {{ existing.quantity + pending.quantity }} {{ article.packaging.name }}
                                        {% endif %}
                                    </p>
                                </div>
                                <button 
                                    type="submit"
                                    class="px-6 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors font-medium flex items-center space-x-2"
                                >
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                    <span>Ajouter</span>
                                </button>
                            </div>
                            <input type="hidden" name="_token" value="{{ csrf_token('inventory_add_' ~ article.id) }}">
                        </form>
                        
                        <form method="POST" action="{{ path('inventories.process-duplicate', {'id': article.id}) }}" class="bg-gray-50 p-4 rounded-lg">
                            <input type="hidden" name="action" value="replace">
                            <input type="hidden" name="family_id" value="{{ pending.family_id ?? '' }}">
                            <div class="flex items-center justify-between">
                                <div>
                                    <h4 class="font-medium text-gray-800">Remplacer le stock existant</h4>
                                    <p class="text-sm text-gray-600">
                                        Le stock actuel sera remplacé par le nouveau. 
                                        {% if article.packaging?article.packaging.name %}
                                        Ex: {{ pending.quantity }} {{ article.packaging.name }} (au lieu de {{ existing.quantity }})
                                        {% endif %}
                                    </p>
                                </div>
                                <button 
                                    type="submit"
                                    class="px-6 py-2 bg-yellow-600 hover:bg-yellow-700 text-white rounded-lg transition-colors font-medium flex items-center space-x-2"
                                >
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                    </svg>
                                    <span>Remplacer</span>
                                </button>
                            </div>
                            <input type="hidden" name="_token" value="{{ csrf_token('inventory_replace_' ~ article.id) }}">
                        </form>
                        
                        <form method="POST" action="{{ path('inventories.process-duplicate', {'id': article.id}) }}" class="bg-gray-50 p-4 rounded-lg">
                            <input type="hidden" name="action" value="cancel">
                            <input type="hidden" name="family_id" value="{{ pending.family_id ?? '' }}">
                            <div class="flex items-center justify-between">
                                <div>
                                    <h4 class="font-medium text-gray-800">Annuler</h4>
                                    <p class="text-sm text-gray-600">
                                        Ne pas enregistrer cette modification et revenir à la liste.
                                    </p>
                                </div>
                                <button 
                                    type="submit"
                                    class="px-6 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition-colors font-medium flex items-center space-x-2"
                                >
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                    <span>Annuler</span>
                                </button>
                            </div>
                            <input type="hidden" name="_token" value="{{ csrf_token('inventory_cancel_' ~ article.id) }}">
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
