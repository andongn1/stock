{% extends 'layouts/app.html.twig' %}

{% block page_title %}Profile{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Informations du profile</h2>
        
        {{ form_start(profileForm) }}
        <div class="space-y-4">
            <div>
                <label for="profile_name" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Nom</label>
                {{ form_widget(profileForm.name, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
                <div class="text-red-500 text-sm mt-1">{{ form_errors(profileForm.name) }}</div>
            </div>
            
            <div>
                <label for="profile_email" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Email</label>
                {{ form_widget(profileForm.email, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
                <div class="text-red-500 text-sm mt-1">{{ form_errors(profileForm.email) }}</div>
            </div>
            
            <div class="flex justify-end">
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                    Mettre a jour
                </button>
            </div>
        </div>
        {{ form_end(profileForm) }}
    </div>
    
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Mettre a jour le mot de passe</h2>
        
        {{ form_start(passwordForm) }}
        <div class="space-y-4">
            <div>
                <label for="password_current_password" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Mot de passe actuel</label>
                {{ form_widget(passwordForm.current_password, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
                <div class="text-red-500 text-sm mt-1">{{ form_errors(passwordForm.current_password) }}</div>
            </div>
            
            <div>
                <label for="password_new_password" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Nouveau mot de passe</label>
                {{ form_widget(passwordForm.new_password, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
                <div class="text-red-500 text-sm mt-1">{{ form_errors(passwordForm.new_password) }}</div>
            </div>
            
            <div>
                <label for="password_new_password_confirmation" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Confirmer le nouveau mot de passe</label>
                {{ form_widget(passwordForm.new_password_confirmation, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
                <div class="text-red-500 text-sm mt-1">{{ form_errors(passwordForm.new_password_confirmation) }}</div>
            </div>
            
            <div class="flex justify-end">
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                    Mettre a jour le mot de passe
                </button>
            </div>
        </div>
        {{ form_end(passwordForm) }}
    </div>
    
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold text-red-600 dark:text-red-400 mb-4">Supprimer le compte</h2>
        <p class="text-gray-600 dark:text-slate-400 mb-4">Une fois votre compte supprime, toutes ses ressources et donnees seront definitivement supprimees.</p>
        
        <form action="{{ path('profile.destroy') }}" method="POST" onsubmit="return confirm('Etes-vous sur de vouloir supprimer votre compte ? Cette action est irreversible.')">
            <input type="hidden" name="_method" value="DELETE">
            <button type="submit" class="px-6 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 transition-colors">
                Supprimer le compte
            </button>
        </form>
    </div>
</div>
{% endblock %}
