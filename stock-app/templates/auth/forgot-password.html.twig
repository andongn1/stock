{% extends 'layouts/guest.html.twig' %}

{% block title %}Mot de passe oublie - Mercuriale App{% endblock %}

{% block content %}
    <h2 class="text-xl font-semibold text-center mb-6">Mot de passe oublie</h2>
    
    <p class="text-sm text-gray-600 mb-6 text-center">
        Indiquez votre adresse email et nous vous enverrons un lien de reinitialisation.
    </p>
    
    <form method="post" action="{{ path('password.email') }}">
        <div class="mb-4">
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                class="w-full p-2 border border-gray-300 rounded-md"
            >
        </div>
        
        <div class="mb-4">
            <button type="submit" class="w-full p-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                Envoyer le lien de reinitialisation
            </button>
        </div>
        
        <div class="text-center text-sm text-gray-600">
            <a href="{{ path('login') }}" class="text-blue-600 hover:underline">
                Retour a la connexion
            </a>
        </div>
    </form>
{% endblock %}
