{% extends 'layouts/guest.html.twig' %}

{% block title %}Connexion - Mercuriale App{% endblock %}

{% block content %}
    <h2 class="text-xl font-semibold text-center mb-6">Se connecter</h2>
    
    <form method="post" action="{{ path('login_check') }}">
        {% if error %}
            <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}
        
        <div class="mb-4">
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input 
                type="email" 
                id="email" 
                name="email" 
                value="{{ last_username ?? '' }}" 
                autocomplete="username" 
                required 
                autofocus 
                class="w-full p-2 border border-gray-300 rounded-md"
            >
        </div>
        
        <div class="mb-4">
            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Mot de passe</label>
            <input 
                type="password" 
                id="password" 
                name="password" 
                autocomplete="current-password" 
                required 
                class="w-full p-2 border border-gray-300 rounded-md"
            >
        </div>
        
        <div class="mb-4 flex items-center">
            <input 
                type="checkbox" 
                id="remember_me" 
                name="remember_me" 
                class="form-check-input"
            >
            <label for="remember_me" class="ml-2 block text-sm text-gray-700">Se souvenir de moi</label>
        </div>
        
        <div class="mb-4">
            <button type="submit" class="w-full p-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                Se connecter
            </button>
        </div>
        
        <div class="text-center text-sm text-gray-600">
            <a href="{{ path('password.request') }}" class="text-blue-600 hover:underline">
                Mot de passe oublie ?
            </a>
        </div>
    </form>
{% endblock %}
