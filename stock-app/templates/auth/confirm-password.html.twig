{% extends 'layouts/guest.html.twig' %}

{% block title %}Confirmer Mot de Passe{% endblock %}

{% block content %}
<div class="max-w-md w-full space-y-8">
    <div class="text-center">
        <h2 class="mt-6 text-3xl font-extrabold text-gray-900 dark:text-white">
            Confirmer le mot de passe
        </h2>
        
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
            C'est une zone securisee de l'application. Veuillez confirmer votre mot de passe avant de continuer.
        </p>
    </div>
    
    {{ form_start(form) }}
    <div class="space-y-6">
        <div>
            <label for="password_current_password" class="block font-medium text-sm text-gray-700 dark:text-gray-300">Mot de passe</label>
            {{ form_widget(form.current_password, {'attr': {'class': 'w-full px-4 py-2 mt-1 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white'}}) }}
            <div class="text-red-500 text-sm mt-1">{{ form_errors(form.current_password) }}</div>
            {% if error %}
            <div class="text-red-500 text-sm mt-1">{{ error }}</div>
            {% endif %}
        </div>
        
        <div>
            <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                Confirmer
            </button>
        </div>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
