{% extends 'layouts/guest.html.twig' %}

{% block title %}Reinitialiser le mot de passe - Mercuriale App{% endblock %}

{% block content %}
    <h2 class="text-xl font-semibold text-center mb-6">Reinitialiser le mot de passe</h2>
    
    <form method="post" action="{{ path('password.store') }}">
        <input type="hidden" name="token" value="{{ token }}">
        
        <div class="mb-4">
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input 
                type="email" 
                id="email" 
                name="email" 
                value="{{ email ?? '' }}" 
                required 
                class="w-full p-2 border border-gray-300 rounded-md"
            >
        </div>
        
        <div class="mb-4">
            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Nouveau mot de passe</label>
            <input 
                type="password" 
                id="password" 
                name="password" 
                required 
                class="w-full p-2 border border-gray-300 rounded-md"
            >
        </div>
        
        <div class="mb-4">
            <label for="password_confirmation" class="block text-sm font-medium text-gray-700 mb-1">Confirmer le mot de passe</label>
            <input 
                type="password" 
                id="password_confirmation" 
                name="password_confirmation" 
                required 
                class="w-full p-2 border border-gray-300 rounded-md"
            >
        </div>
        
        <div class="mb-4">
            <button type="submit" class="w-full p-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                Reinitialiser le mot de passe
            </button>
        </div>
    </form>
{% endblock %}
