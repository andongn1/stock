{% extends 'layouts/app.html.twig' %}

{% block page_title %}Changer Mot de Passe{% endblock %}

{% block content %}
<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800 dark:text-white">Changer le mot de passe</h1>
    </div>
    
    {{ form_start(form) }}
    <div class="space-y-6">
        <div>
            <label for="password_current_password" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Mot de passe actuel *</label>
            {{ form_widget(form.current_password, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
            <div class="text-red-500 text-sm mt-1">{{ form_errors(form.current_password) }}</div>
            {% if error %}
            <div class="text-red-500 text-sm mt-1">{{ error }}</div>
            {% endif %}
        </div>
        
        <div>
            <label for="password_new_password" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Nouveau mot de passe *</label>
            {{ form_widget(form.new_password, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
            <div class="text-red-500 text-sm mt-1">{{ form_errors(form.new_password) }}</div>
        </div>
        
        <div>
            <label for="password_new_password_confirmation" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Confirmer le nouveau mot de passe *</label>
            {{ form_widget(form.new_password_confirmation, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-slate-700 text-gray-900 dark:text-white'}}) }}
            <div class="text-red-500 text-sm mt-1">{{ form_errors(form.new_password_confirmation) }}</div>
        </div>
        
        <div class="flex justify-end">
            <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                Mettre a jour le mot de passe
            </button>
        </div>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
